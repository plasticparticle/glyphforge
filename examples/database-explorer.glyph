                              "kind": "code",
                              "props": {
                                "line_numbers": true,
                                "text": "select o.id, c.name, o.total, o.status\n  from orders o\n  join customers c on c.id = o.customer_id\n where o.created_at > now() - interval '1 day'\n order by o.total desc limit 50;"
